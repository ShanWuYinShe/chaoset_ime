# 构建产物（带 / 前缀锚定仓库根目录，避免误吞同名源码目录）
bin/
dist/
/build/
/chaoset-engine
shims/macos/build/
shims/windows/build/
# Linux 原生设置窗本地构建产物（build.sh 默认输出到源码目录）
shims/linux/setup/chaoset-setup

# 运行产物
*.sock
# daemon 单实例 flock 锁文件（<socket>.lock）与损坏用户词典备份
# （userdict.json.corrupt-<时间戳>）。2026-10-31 审计 P2：此前未忽略，
# 误在仓库根跑 daemon/测试后会以未跟踪文件出现在 git status。
*.sock.lock
chaoset-userdict.json
chaoset-userdict.json.tmp
chaoset-userdict.json.corrupt-*

# 中间产物与 worktree
.worktrees/
.workwork/

# macOS 系统文件（Finder 在任意目录层级生成，含仓库根目录）
# 单条 .DS_Store 已能匹配任意层级，**/.DS_Store 为显式写法，便于一眼看出覆盖全仓
.DS_Store
**/.DS_Store

# Go 测试二进制（go test -cpuprofile 等会生成）
*.test

# 仓库根目录的临时分析产物（历史上出现过 analyze_top2 这类 4MB 调试二进制，
# 既不匹配任何忽略规则也不在 bin/ 下，`git add -A` 会把它提交进来）
/analyze_*

# 误在仓库根跑 `go build ./cmd/xxx` 会直接产出二进制到当前目录（不带 -o 时
# Go 以包名命名）。2026-10-26 就误出过一个 chaosetd，差点被提交。
/chaosetd
/chaoset-cli
/chaoset-import
/chaoset-dictgen
/chaoset-userdict
/chaoset-engine
# 工具编译产物（2026-10-30 曾被 git add -A 意外带入仓库，a0d4bcc）
/checkgdi
/checkworkflows
