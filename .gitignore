# 构建产物（带 / 前缀锚定仓库根目录，避免误吞同名源码目录）
bin/
dist/
/ibus-engine
/chaoset-ibus-engine
/build/
shims/macos/build/
shims/windows/build/
# Linux 壳的容器构建产物目录（setup-container.sh 会往这里写二进制）。
# 此前只忽略了 macos/windows，Linux 这个漏了——实测
# `git check-ignore shims/linux/build/chaoset-ibus-engine` 退出码 1（未忽略），
# 一旦有人在 shims/linux/ 下误跑脚本再 git add -A 就会把二进制提交进来。
shims/linux/build/

# 运行产物
*.sock
chaoset-userdict.json
chaoset-userdict.json.tmp

# 中间产物与 worktree
.worktrees/
.workwork/

# macOS 系统文件（Finder 在任意目录层级生成，含仓库根目录）
# 单条 .DS_Store 已能匹配任意层级，**/.DS_Store 为显式写法，便于一眼看出覆盖全仓
.DS_Store
**/.DS_Store

# Go 测试二进制（go test -cpuprofile 等会生成）
*.test

# 仓库根目录的临时分析产物（历史上出现过 analyze_top2 这类 4MB 调试二进制，
# 既不匹配任何忽略规则也不在 bin/ 下，`git add -A` 会把它提交进来）
/analyze_*

# 误在仓库根跑 `go build ./cmd/xxx` 会直接产出二进制到当前目录（不带 -o 时
# Go 以包名命名）。2026-10-26 就误出过一个 chaosetd，差点被提交。
/chaosetd
/chaoset-cli
/chaoset-import
/chaoset-dictgen
/chaoset-userdict
/chaoset-engine
