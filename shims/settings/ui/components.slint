import { Theme } from "tokens.slint";

// ---- 优雅自绘开关控件 ----
export component ChaosSwitch {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: Theme.switch_width;
    height: Theme.switch_height;

    track := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 11px;
        background: root.checked ? (touch.has-hover ? Theme.accent_pressed : Theme.accent)
                                 : (touch.has-hover ? Theme.control_hover : Theme.control_bg);
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.control_border;
        animate background { duration: 150ms; easing: ease-in-out; }

        knob := Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.knob;
            drop-shadow-color: rgba(0, 0, 0, 0.15);
            drop-shadow-blur: 2px;
            drop-shadow-offset-y: 1px;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: pointer;
    }
}

// ---- 单选胶囊选项 ----
export component ChoicePill {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    horizontal-stretch: 1;

    rect := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.control_radius;
        background: root.selected ? Theme.accent_soft
                                  : (touch.has-hover ? Theme.control_hover : Theme.control_bg);
        border-width: 1px;
        border-color: root.selected ? Theme.accent : Theme.control_border;
        animate background { duration: 120ms; }
        animate border-color { duration: 120ms; }

        txt := Text {
            text: root.text;
            color: root.selected ? Theme.accent_text : Theme.text_primary;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---- 操作按钮 ----
export component ChaosButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: Theme.button_height;

    rect := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.control_radius;
        background: root.primary
            ? (touch.pressed ? Theme.accent_pressed : (touch.has-hover ? Theme.accent_pressed : Theme.accent_strong))
            : (touch.pressed ? Theme.control_hover : (touch.has-hover ? Theme.control_hover : Theme.control_bg));
        border-width: root.primary ? 0px : 1px;
        border-color: Theme.control_border;
        animate background { duration: 120ms; }

        txt := Text {
            text: root.text;
            color: root.primary ? Theme.on_accent
                                : (root.danger ? Theme.danger : Theme.control_text);
            font-size: 13px;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---- 关于页快捷键行（两列：按键 + 说明） ----
export component ShortcutRow {
    in property <string> keys;
    in property <string> action;

    height: 16px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.keys;
            width: 96px;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text_primary;
            vertical-alignment: center;
        }
        Text {
            text: root.action;
            font-size: 11px;
            color: Theme.text_secondary;
            vertical-alignment: center;
        }
    }
}

// ---- 卡片容器 ----
export component Card inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in property <string> hint: "";

    border-radius: Theme.card_radius;
    background: Theme.card_bg;
    border-width: 1px;
    border-color: Theme.card_border;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;

    VerticalLayout {
        padding: Theme.card_pad;
        spacing: Theme.card_gap;

        if root.title != "" : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: Theme.text_secondary;
            }
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text_secondary;
                vertical-alignment: center;
            }
        }

        @children

        if root.hint != "" : Text {
            text: root.hint;
            font-size: 11px;
            color: Theme.text_secondary;
            wrap: word-wrap;
        }
    }
}

// ---- 候选窗实机微预览条 ----
// 色值/几何对齐 shims/macos/src/CandidateTheme.swift 的深浅两套候选窗；改真实候选窗
// 视觉时必须同步本预览，避免设置页展示与实机再次漂移。
// 与 macOS/Windows 真实候选窗同构：候选序号键帽、蓝色预选胶囊、学习绿星、
// 右侧「齿轮 + 页码 + 上下翻页箭头」。不画预编辑（真实候选窗外的拼音由宿主内联）。
export component CandidatePreviewItem inherits Rectangle {
    in property <string> index: "";
    in property <string> text: "";
    in property <bool> selected: false;
    in property <bool> learned: false;

    height: 27px;
    border-radius: 5px;
    background: root.selected ? (Theme.is_dark ? #0066EB : #007AFF) : Colors.transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 5px;
        spacing: 3px;
        alignment: start;

        // 序号键帽：未选中双层描边，选中为胶囊内半透白单层键帽。
        Rectangle {
            width: 14px;
            height: 17px;
            border-radius: 3px;
            background: root.selected
                ? rgba(255, 255, 255, 0.27)
                : (Theme.is_dark ? #223353 : #FFFFFF);
            border-width: root.selected ? 0px : 1px;
            border-color: Theme.is_dark ? rgba(255, 255, 255, 0.25) : rgba(0, 0, 0, 0.24);

            Text {
                text: root.index;
                width: 100%;
                height: 100%;
                color: root.selected ? #FFFFFF : (Theme.is_dark ? #F2F6FC : #1D1D1F);
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            color: root.selected ? #FFFFFF : (Theme.is_dark ? #F2F6FC : #1D1D1F);
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            text: "*";
            visible: root.learned;
            color: Theme.is_dark ? #30D158 : #34C759;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

export component CandidatePreview inherits Rectangle {
    height: 42px;
    border-radius: 8px;
    background: Theme.is_dark ? #1A2740 : #F6F6F8;
    border-width: 1px;
    border-color: Theme.is_dark ? rgba(255, 255, 255, 0.14) : rgba(0, 0, 0, 0.10);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: start;

        CandidatePreviewItem { index: "1"; text: "真实"; selected: true; learned: true; }
        CandidatePreviewItem { index: "2"; text: "真是"; learned: true; }
        CandidatePreviewItem { index: "3"; text: "珍视"; }
        CandidatePreviewItem { index: "4"; text: "阵式"; }
        CandidatePreviewItem { index: "5"; text: "阵势"; }
        CandidatePreviewItem { index: "6"; text: "诊室"; }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 1px;
            height: 22px;
            background: Theme.is_dark ? rgba(255, 255, 255, 0.12) : rgba(0, 0, 0, 0.08);
        }

        Image {
            source: @image-url("icons/gear.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.is_dark ? #7E90AC : #8E8E93;
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;

            Image {
                source: @image-url("icons/arrow-up.svg");
                width: 7px;
                height: 7px;
                colorize: Theme.is_dark ? #7E90AC : #8E8E93;
            }
            Text {
                text: "1/12";
                color: Theme.is_dark ? #7E90AC : #8E8E93;
                font-size: 9px;
                horizontal-alignment: center;
            }
            Image {
                source: @image-url("icons/arrow-down.svg");
                width: 7px;
                height: 7px;
                colorize: Theme.is_dark ? #7E90AC : #8E8E93;
            }
        }
    }
}
