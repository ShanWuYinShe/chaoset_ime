// Windows 资源脚本模板：应用图标 + 版本信息（VS_VERSION_INFO）。
// 图标：资源 ID 1 即为主图标（IconIndex 0），供 Windows 语言栏、系统托盘和
// 切换菜单提取展示；注册表 IconFile 指向本 DLL（win32.cpp RegisterProfile）。
// 版本：@VERSION@ / @VERSION_QUAD@ / @FILE_TYPE@ 等是构建期占位符——Makefile / build.sh 从
// git tag 推导出的 $(VERSION)（单一真源）经 sed 注入生成 chaoset.gen.rc 后
// 再交给 windres 编译，源码里不写死任何版本号。VERSION_QUAD 是 4 段数字版本
// （如 0.3.17.0），VS_FIXEDFILEINFO 只接受数字；@VERSION@ 是人类可读版本
// （如 0.3.17 或 0.0.0-dev），用于属性页的字符串字段。
//
// 同一份模板同时用于 ChaosetIME.dll / ChaosetIME32.dll / chaoset-ui.exe，
// 让「右键属性 → 详细信息」在前端 DLL 与 UI 宿主上都显示同样的 app 信息。
1 ICON "chaoset.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,@VER_BUILD@
 PRODUCTVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,@VER_BUILD@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE @FILE_TYPE@L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 简体中文（0x0804）+ Unicode（1200）；与安装器的 SimpChinese 一致。
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ShanWuYinShe"
            VALUE "FileDescription", "@FILE_DESCRIPTION@"
            VALUE "FileVersion", "@VERSION_QUAD@"
            VALUE "InternalName", "@INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 ShanWuYinShe"
            VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
            VALUE "ProductName", "Chaoset 拼音输入法"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "Comments", "跨平台中文输入法 Chaoset（MIT 许可，词库 CC BY-SA 4.0）"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
