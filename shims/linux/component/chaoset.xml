<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.Chaoset</name>
  <description>Chaoset Input Method</description>
  <exec>/usr/bin/chaoset-engine --ibus</exec>
  <!-- 占位符 @VERSION@，由 Makefile 的 $(VERSION) 在打包时替换：tag 触发的 CI 用 tag 号，其余用 commit hash。不要写死数字：此处曾停在 0.1.0 而 tag 已是 v0.2.12。 -->
  <version>@VERSION@</version>
  <author>chaoset</author>
  <license>MIT</license>
  <engines>
    <engine>
      <name>chaoset</name>
      <longname>Chaoset Pinyin</longname>
      <language>zh</language>
      <license>MIT</license>
      <author>chaoset</author>
      <layout>us</layout>
      <rank>99</rank>
      <symbol>中</symbol>
      <icon>chaoset</icon>
      <!-- 设置入口：ibus-setup 显示「首选项」按钮并运行本命令。
           chaoset-setup 只是纯 POSIX C 启动器：找到并 exec Slint 统一设置中心
           chaoset-settings（设置界面唯一实现；找不到时报错退出，无旧设置窗回退）。 -->
      <setup>/usr/share/chaoset/chaoset-setup</setup>
    </engine>
  </engines>
</component>
