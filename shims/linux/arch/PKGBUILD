# Maintainer: ShanWuYinShe <https://github.com/ShanWuYinShe/chaoset_ime>
pkgname=chaoset-ime
# 占位符 @VERSION@，本地 makepkg 前请用 scripts/version.sh --pkg 的输出替换（必须以数字开头）。CI 的 package.sh 由 Makefile 传 PKG_VERSION。
pkgver=@VERSION@
pkgrel=1
pkgdesc="Chaoset Pinyin IME - 傻瓜式现代拼音输入法"
arch=('x86_64' 'aarch64')
url="https://github.com/ShanWuYinShe/chaoset_ime"
license=('MIT')
# 设置界面唯一实现是 Slint 统一设置中心 chaoset-settings（不再有 GTK3 设置窗），
# 因此运行时/构建时都不需要 gtk3。
depends=('ibus' 'libxkbcommon' 'libxkbcommon-x11' 'fontconfig')
# 发行面已 100% Rust（CLI/daemon/设置中心/词库导入）：构建不再需要 Go。
makedepends=('rust' 'gcc' 'pkgconf' 'ibus')
install=chaoset-ime.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/ShanWuYinShe/chaoset_ime/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "chaoset_ime-$pkgver"
    mkdir -p bin
    # 全能 CLI 是 Rust 单二进制（crates/chaosetctl，argv[0] multicall）：
    # 发行名 chaoset/chaoset-cli/chaoset-import/chaoset-userdict 由下面的软链提供。
    cargo build --release --bin chaosetctl --manifest-path crates/Cargo.toml
    install -Dm755 crates/target/release/chaosetctl bin/chaosetctl
    # daemon 唯一实现是 Rust（crates/chaosetd）。
    cargo build --release --bin chaosetd --manifest-path crates/Cargo.toml
    install -Dm755 crates/target/release/chaosetd bin/chaosetd
    (cd bin && ln -sf chaosetctl chaoset && ln -sf chaosetctl chaoset-cli && ln -sf chaosetctl chaoset-import && ln -sf chaosetctl chaoset-userdict)
    # Slint 统一设置中心（chaoset-settings）：Linux 设置的唯一实现，必须随包分发。
    cargo build --release --manifest-path shims/settings/Cargo.toml
    install -Dm755 shims/settings/target/release/chaoset-settings bin/chaoset-settings
    # 发布用二进制词库编译器（构建期）：TSV 仍入库，打包装配为 CSDB。
    cargo build --release --bin dictc --manifest-path crates/Cargo.toml
    # Linux 引擎是原生 C++/libibus 壳，必须用 g++ 与 ibus 头文件构建；
    # 拼音/联想在 Rust daemon（crates/chaosetd）中通过 Unix socket 提供。
    sh shims/linux/engine/build.sh bin/chaoset-engine
}

package() {
    cd "chaoset_ime-$pkgver"
    install -d "$pkgdir/usr/bin"
    cp -d bin/* "$pkgdir/usr/bin/"
    # 设置入口依赖统一设置中心：包里缺了它「首选项」只会报错，视为打包失败。
    test -x "$pkgdir/usr/bin/chaoset-settings" || { echo "错误：缺少统一设置中心 chaoset-settings" >&2; exit 1; }

    # Compatibility symlinks in /usr/local/bin
    install -d "$pkgdir/usr/local/bin"
    ln -sf /usr/bin/chaoset-engine "$pkgdir/usr/local/bin/chaoset-engine"
    ln -sf /usr/bin/chaosetd "$pkgdir/usr/local/bin/chaosetd"
    ln -sf /usr/bin/chaosetctl "$pkgdir/usr/local/bin/chaosetctl"
    ln -sf /usr/bin/chaosetctl "$pkgdir/usr/local/bin/chaoset-cli"

    # Dictionary
    install -Dm644 data/dict_common.tsv "$pkgdir/usr/share/chaoset/dict.tsv"
    crates/target/release/dictc data/dict_common.tsv "$pkgdir/usr/share/chaoset/dict.bin"

    # IBus component
    install -Dm644 shims/linux/component/chaoset.xml "$pkgdir/usr/share/ibus/component/chaoset.xml"

    # 设置启动器（ibus-setup 的 <setup> 入口）：纯 POSIX C，只 exec chaoset-settings。
    sh shims/linux/setup/build.sh "$pkgdir/usr/share/chaoset/chaoset-setup"

    # Icons
    install -Dm644 shims/linux/chaoset-settings.desktop "$pkgdir/usr/share/applications/chaoset-settings.desktop"
    install -Dm644 shims/linux/icons/hicolor/48x48/apps/chaoset.png "$pkgdir/usr/share/icons/hicolor/48x48/apps/chaoset.png"
    install -Dm644 shims/linux/icons/hicolor/128x128/apps/chaoset.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/chaoset.png"
    install -Dm644 shims/linux/icons/hicolor/256x256/apps/chaoset.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/chaoset.png"
    install -Dm644 shims/linux/icons/hicolor/scalable/apps/chaoset.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/chaoset.svg"
}
