# Maintainer: ShanWuYinShe <https://github.com/ShanWuYinShe/chaoset_ime>
pkgname=chaoset-ime-bin
_pkgname=chaoset-ime
# 占位符 @VERSION@，由 Makefile 的 $(VERSION)（源自 git tag）在打包时替换。
pkgver=@VERSION@
pkgrel=1
pkgdesc="Chaoset Pinyin IME (prebuilt binary) - 傻瓜式现代拼音输入法"
arch=('x86_64')
url="https://github.com/ShanWuYinShe/chaoset_ime"
license=('MIT')
depends=('ibus')
provides=('chaoset-ime')
conflicts=('chaoset-ime')
install=chaoset-ime.install
source=("https://github.com/ShanWuYinShe/chaoset_ime/releases/download/v$pkgver/chaoset-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/chaoset-linux-x86_64"
    install -Dm755 bin/chaosetd "$pkgdir/usr/bin/chaosetd"
    install -Dm755 bin/chaoset-cli "$pkgdir/usr/bin/chaoset-cli"
    install -Dm755 bin/chaoset-import "$pkgdir/usr/bin/chaoset-import"
    install -Dm755 bin/chaoset-userdict "$pkgdir/usr/bin/chaoset-userdict"
    install -Dm755 bin/chaoset-engine "$pkgdir/usr/bin/chaoset-engine"

    install -d "$pkgdir/usr/local/bin"
    ln -sf /usr/bin/chaoset-engine "$pkgdir/usr/local/bin/chaoset-engine"
    ln -sf /usr/bin/chaosetd "$pkgdir/usr/local/bin/chaosetd"
    ln -sf /usr/bin/chaoset-cli "$pkgdir/usr/local/bin/chaoset-cli"

    install -Dm644 data/dict.tsv "$pkgdir/usr/share/chaoset/dict.tsv"
    # 设置窗口脚本（component XML 的 <setup> 指向它）：此前漏装导致
    # ibus-setup「首选项」点了没反应（2026-10-30 审计 B-P1-6）。
    install -Dm755 setup/chaoset-setup.py "$pkgdir/usr/share/chaoset/chaoset-setup.py"
    install -Dm644 component/chaoset.xml "$pkgdir/usr/share/ibus/component/chaoset.xml"

    # 目标目录必须先创建：`cp -r src dst/` 在 dst 不存在时直接失败
    # （"No such file or directory"），而同函数上面几行都用 install -D 自动建
    # 父目录，唯独这里漏了——2026-10-26 在 macOS 上实测复现 exit 1。
    install -d "$pkgdir/usr/share/icons"
    cp -r icons/hicolor "$pkgdir/usr/share/icons/"
}
